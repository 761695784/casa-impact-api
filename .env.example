APP_NAME=Casa-Impact
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Nom de domaine (accord du 2026-09-14) : le backend est destiné à être servi
# sur api.casaimpact.org, le frontend Next.js sur casaimpact.org. En local,
# garder http://localhost:8000 (ou le port utilisé par `php artisan serve`) —
# ne changer cette valeur que sur le vrai serveur de production.
APP_URL=api.casaimpact.org

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.casaimpact.org #(le point au début permet au  cookie de session/XSRF d'être partagé entre casaimpact.org etapi.casaimpact.org). En local, laisser à null.
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=casaimpact.org,www.casaimpact.org

# Origine(s) autorisées à appeler l'API depuis un navigateur (voir
# config/cors.php). Plusieurs origines séparées par une virgule.
CORS_ALLOWED_ORIGINS=https://casaimpact.org

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=casaimpactF0rt@gmail.com
MAIL_PASSWORD="paix majn vpcs kcjr"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=casaimpactF0rt@gmail.com
MAIL_FROM_NAME="Casa Impact"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
